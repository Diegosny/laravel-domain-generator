{
  "name": "domain/laravel-domain-generator",
  "description": "Pacote Artisan para geracao automatica de estrutura por Dominio com Abstract Controllers, Services e Repositories",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Diego Silva",
      "email": "diegocamilo021@gmail.com"
    }
  ],
  "require": {
    "php": "^8.1",
    "illuminate/support": "^10.0|^11.0|^12.0|^13.0"
  },
  "autoload": {
    "psr-4": {
      "Domain\\DomainGenerator\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Domain\\DomainGenerator\\DomainGeneratorServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}