{
  "name": "domain/laravel-domain-generator",
  "description": "Pacote Laravel para geração automática de estruturas por domínio utilizando DDD, DTOs, Services, Repositories, Controllers e Form Requests",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Diego Silva",
      "email": "diegocamilo021@gmail.com"
    }
  ],
  "require": {
    "php": "^8.1",
    "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
    "php-open-source-saver/jwt-auth": "^2.1"
  },
  "autoload": {
    "psr-4": {
      "Domain\\DomainGenerator\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Domain\\DomainGenerator\\Providers\\DomainGeneratorServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "require-dev": {
    "laravel/pint": "^1.30",
    "phpstan/phpstan": "^2.2"
  }
}
